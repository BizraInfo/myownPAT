{
	"name": "@earendil-works/pi-knowledge-fabric",
	"version": "0.99.1",
	"description": "Isolated knowledge fabric with a governance-split retrieval spine: PAT proposes cited answers, SAT verifies citations model-blind, DEMA surfaces labelled results",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"knowledge",
		"retrieval",
		"graphrag",
		"governance",
		"citations"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/knowledge-fabric"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.11"
	}
}
